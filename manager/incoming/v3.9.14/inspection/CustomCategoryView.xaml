<UserControl x:Class="FreeCamManager.Views.CustomCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeCamManager.Controls">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="自定义分类" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock Text="自行创建的分类及其文件；原有分类仍在各自页面" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}" Content="刷新"/>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Categories.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Categories.Count}" Value="1">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Height="35"
                  Style="{StaticResource ModernComboBoxStyle}"/>
        <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="35"
                 Style="{StaticResource ModernTextBoxStyle}" ToolTip="搜索文件名、分类、备注"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="9">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="9,2,9,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/>
            <ColumnDefinition Width="90"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="文件" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="分类" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="测试状态 / 拖拽" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="3" Text="导入时间" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
        </Grid>
        <ListView x:Name="CustomList" Grid.Row="1"
                  ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MouseDoubleClick="CustomList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="CustomList_PreviewMouseRightButtonDown"
                  HorizontalContentAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="MinHeight" Value="38"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
              </Style.Triggers>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="7,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileNameToolTip}"/>
                <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <controls:StatusBadge Grid.Column="2" Text="{Binding TestStatus}"
                    PreviewMouseLeftButtonDown="ResultBadge_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ResultBadge_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="ResultBadge_PreviewMouseLeftButtonUp"
                    ToolTip="{Binding ResultHint}"/>
                <TextBlock Grid.Column="3" Text="{Binding TimeDisplay}" Foreground="{DynamicResource TextMutedBrush}"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
          <ListView.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="开始测试（双击）" Command="{Binding SelectedRow.StartTestCommand}"/>
              <MenuItem Header="打开测试目录" Command="{Binding SelectedRow.OpenTestingFolderCommand}"/>
              <MenuItem Header="指定此版本启动文件" Command="{Binding SelectedRow.SelectLaunchCommand}"/>
              <MenuItem Header="恢复全局启动规则" Command="{Binding SelectedRow.ClearLaunchOverrideCommand}"/>
              <Separator/>
              <MenuItem Header="定位当前结果" Command="{Binding SelectedRow.OpenResultCommand}"/>
              <MenuItem Header="指定此版本拖拽文件" Command="{Binding SelectedRow.SelectDragCommand}"/>
              <MenuItem Header="恢复全局拖拽规则" Command="{Binding SelectedRow.ClearDragOverrideCommand}"/>
              <Separator/>
              <MenuItem Header="打开文件所在位置" Command="{Binding SelectedRow.OpenLocationCommand}"/>
              <MenuItem Header="编辑备注" Command="{Binding SelectedRow.EditNotesCommand}"/>
            </ContextMenu>
          </ListView.ContextMenu>
        </ListView>

        <TextBlock Grid.Row="1"
                   Text="尚未创建自定义分类，可在 设置 → 自定义规则 → 自动分类 中新增"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Categories.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Categories.Count}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="1" Text="该分类暂无文件"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Categories.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Categories.Count}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>
