<UserControl x:Class="FreeCamManager.Views.RuleEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RuleTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="0,0,0,8"/>
              <Border Grid.Row="1" Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="7">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RuleTabItemStyle" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource PanelCardStyle}">
    <StackPanel>
      <TextBlock Text="自定义规则" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock Text="三套规则彼此独立，列表从上到下依次匹配。修改后请点击下方「保存全部自定义规则」。"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,13"/>
      <TabControl MinHeight="330" Style="{StaticResource RuleTabControlStyle}">
        <TabItem Header="启动文件" Style="{StaticResource RuleTabItemStyle}">
          <StackPanel Margin="10">
            <TextBlock Text="双击测试包仍先解压到 01_Testing；仅从测试目录查找启动文件。可为单个版本右键指定。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
            <WrapPanel Margin="0,0,0,10">
              <Button Style="{StaticResource RoundedButtonStyle}" Content="新增规则" Command="{Binding AddLaunchRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="删除" Command="{Binding RemoveLaunchRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="上移" Command="{Binding MoveLaunchUpCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="下移" Command="{Binding MoveLaunchDownCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="恢复原有规则" Command="{Binding ResetLaunchRulesCommand}"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding LaunchRules}" SelectedItem="{Binding SelectedLaunchRule, Mode=TwoWay}"
                     Height="196" HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource DividerBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="启用" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" ToolTip="支持 * 和 ?，例如 Start*.cmd"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="示例：Start.cmd → Start.bat → Start*.cmd；若全未命中则手动选文件。"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,0,0"/>
          </StackPanel>
        </TabItem>

        <TabItem Header="拖拽文件" Style="{StaticResource RuleTabItemStyle}">
          <StackPanel Margin="10">
            <TextBlock Text="完全按下方规则匹配。没有匹配项就提示，绝不自动退回 .log；单个版本可右键指定文件。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
            <WrapPanel Margin="0,0,0,10">
              <Button Style="{StaticResource RoundedButtonStyle}" Content="新增规则" Command="{Binding AddDragRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="删除" Command="{Binding RemoveDragRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="上移" Command="{Binding MoveDragUpCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="下移" Command="{Binding MoveDragDownCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="恢复原有规则" Command="{Binding ResetDragRulesCommand}"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding DragRules}" SelectedItem="{Binding SelectedDragRule, Mode=TwoWay}"
                     Height="196" HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource DividerBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="启用" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" ToolTip="例如 *_Result.zip、*Results*.zip 或 *.log"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="仅搜索当前测试目录和已关联的 40_Result；忽略 Prior / Evidence 历史参考目录。"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,0,0"/>
          </StackPanel>
        </TabItem>

        <TabItem Header="自动分类" Style="{StaticResource RuleTabItemStyle}">
          <StackPanel Margin="10">
            <TextBlock Text="匹配字段使用中文显示；分类标签可选择已有标签，也可直接输入新的自定义标签。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,5"/>
            <TextBlock Text="目标目录相对于 FreeCam 根目录；支持 {Feature}、{Stage}、{Version}。未匹配则留在收件箱。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,10">
              <Button Style="{StaticResource RoundedButtonStyle}" Content="新增分类" Command="{Binding AddClassificationRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="删除" Command="{Binding RemoveClassificationRuleCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="上移" Command="{Binding MoveClassificationUpCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="下移" Command="{Binding MoveClassificationDownCommand}" Margin="0,0,6,0"/>
              <Button Style="{StaticResource RoundedButtonStyle}" Content="恢复原有规则" Command="{Binding ResetClassificationRulesCommand}"/>
            </WrapPanel>
            <Grid Margin="6,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/><ColumnDefinition Width="136"/><ColumnDefinition Width="178"/>
                <ColumnDefinition Width="148"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="启用" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="1" Text="匹配字段" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="2" Text="匹配内容" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="3" Text="分类标签" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="4" Text="目标目录" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <ListBox ItemsSource="{Binding ClassificationRules}"
                     SelectedItem="{Binding SelectedClassificationRule, Mode=TwoWay}"
                     Height="244" HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource DividerBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50"/><ColumnDefinition Width="136"/><ColumnDefinition Width="178"/>
                      <ColumnDefinition Width="148"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DataContext.RuleFieldLabels, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              SelectedItem="{Binding FieldLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0"
                              ToolTip="选择按哪一项信息判断文件"/>
                    <TextBox Grid.Column="2" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,5,0"
                             ToolTip="支持 * 和 ? 通配符"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding DataContext.CategoryTagLabels, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              Text="{Binding CategoryLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" IsTextSearchEnabled="False"
                              Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,5,0"
                              ToolTip="可选择已有标签，也可直接输入新的自定义标签"/>
                    <TextBox Grid.Column="4" Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Result 属于测试结果配对/拖拽，不作为自定义分类规则；Stable 安全校验保持有效。"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </TabItem>
      </TabControl>

      <Button Content="保存全部自定义规则" Command="{Binding SaveCommand}"
              Style="{StaticResource RoundedButtonStyle}" Height="35" HorizontalAlignment="Right"
              Margin="0,14,0,2" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
    </StackPanel>
  </Border>
</UserControl>
