<UserControl x:Class="FreeCamManager.Views.StableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeCamManager.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Stable（稳定版）" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="检查冻结材料、确认稳定版并同步备份盘" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SyncBackupCommand}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35" Width="15" Height="15"/><TextBlock Text="同步 / 校验备份" Margin="7,0,0,0"/></StackPanel></Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35" Width="15" Height="15"/><TextBlock Text="刷新" Margin="7,0,0,0"/></StackPanel></Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="85"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="版本" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="运行包" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="完整源码" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="Repo.bundle" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="SHA256" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="完整度" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="状态" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                </Grid>
                <ListView x:Name="StableList" Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,4" MinHeight="38"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="85"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding RuntimeText}"/><TextBlock Grid.Column="2" Text="{Binding SourceText}"/><TextBlock Grid.Column="3" Text="{Binding RepoText}"/><TextBlock Grid.Column="4" Text="{Binding Sha256Text}"/><TextBlock Grid.Column="5" Text="{Binding CompletenessText}"/><TextBlock Grid.Column="6" Text="{Binding StateText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                 <controls:ScrollToTopButton Grid.Row="1" TargetList="{Binding ElementName=StableList}" Panel.ZIndex="20"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8,10,8,2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="确认 Stable 只要求运行包 + 完整源码；SHA256 会自动生成，Repo.bundle 可选。" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/><Button Grid.Column="1" Style="{StaticResource RoundedButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding ConfirmStableCommand}" Content="{Binding ConfirmButtonText}"/></Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
