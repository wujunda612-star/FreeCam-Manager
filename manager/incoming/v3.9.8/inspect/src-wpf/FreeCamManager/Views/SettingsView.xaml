<UserControl x:Class="FreeCamManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeCamManager.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="目录、显示方式和更新设置" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Directory card -->
            <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="目录" FontWeight="SemiBold"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="FreeCam 根目录" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RootDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Command="{Binding ChooseRootCommand}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Width="14" Height="14"/><TextBlock Text="选择" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="4" Text="00_Downloa（收件箱）" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding InboxDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Command="{Binding ChooseInboxCommand}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInbox}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Width="14" Height="14"/><TextBlock Text="选择" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="8" Text="Stable Backup（稳定版备份盘，可选）" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding StableBackupDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Command="{Binding ChooseBackupCommand}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconArchive}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Width="14" Height="14"/><TextBlock Text="选择" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="12" Text="Logs（诊断日志）" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Grid.Row="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LogDir, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding ManagerLoggingEnabled, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Manager 日志记录：只控制 Manager 自身诊断日志，不影响测试包 Result / 测试日志。"/>
                            <Button Grid.Column="4" Style="{StaticResource RoundedButtonStyle}" Command="{Binding ChooseLogsCommand}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconNote}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Width="14" Height="14"/><TextBlock Text="选择" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"/>

                    <Grid Grid.Row="6" x:Name="SettingsRowScan">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel Width="140" HorizontalAlignment="Left">
                            <TextBlock Text="自动扫描间隔（秒）" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ScanSecondsTextBox" Text="{Binding ScanSeconds, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernTextBoxStyle}" Width="140" HorizontalAlignment="Left" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding SaveCommand}" Content="保存设置" Height="34" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Display and behavior card -->
            <Border Grid.Row="4" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="显示与行为" FontWeight="SemiBold"/>

                    <Grid Grid.Row="2" x:Name="SettingsBehaviorGrid" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="界面主题" Style="{StaticResource FieldLabelStyle}"/>
                            <controls:CompactPickerControl ItemsSource="{Binding Themes}" SelectedValue="{Binding SelectedTheme, Mode=TwoWay}" Width="120" Height="34" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="已废弃自动删除" Style="{StaticResource FieldLabelStyle}"/>
                            <controls:CompactPickerControl ItemsSource="{Binding DiscardDeletePolicies}" SelectedValue="{Binding SelectedDiscardDeletePolicy, Mode=TwoWay}" Width="145" Height="34" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="隐藏 FreeCam_ 文件名前缀" Style="{StaticResource FieldLabelStyle}"/>
                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding HideFreeCamPrefix, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" ToolTip="只改变列表显示，不修改磁盘文件名、路径、Manifest、BuildId 或 Result 配对。">
                            <TextBlock Text="显示文件名中文别名" Style="{StaticResource FieldLabelStyle}"/>
                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding ShowFilenameAliases, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" ToolTip="开启后功能列显示中文；悬浮时显示原始字段。">
                            <TextBlock Text="功能中文显示" Style="{StaticResource FieldLabelStyle}"/>
                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding ShowFeatureAliases, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4" ToolTip="开启后阶段列显示中文；悬浮时显示原始字段。">
                            <TextBlock Text="阶段中文显示" Style="{StaticResource FieldLabelStyle}"/>
                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding ShowStageAliases, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" x:Name="SettingsRowTerms">
                        <Grid.ColumnDefinitions><ColumnDefinition MinWidth="270"/><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="中文术语表" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding TermsSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TermsLastCheckedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding TermsSyncStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource RoundedButtonStyle}" Command="{Binding OpenFilenameTermsCommand}" Content="打开术语表" Height="32" Padding="12,0"/>
                            <Button Style="{StaticResource RoundedButtonStyle}" Command="{Binding ReloadFilenameTermsCommand}" Content="重新加载" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource RoundedButtonStyle}" Command="{Binding CheckTermsUpdateCommand}" Content="检查更新" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Three independent, editable rules; ordered from top to bottom -->
            <Border Grid.Row="6" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Text="自定义规则" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="启动、拖拽、分类互不干扰。优先匹配列表第一条启用规则；修改后点击保存。"
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="① 启动文件规则" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ 新增" Command="{Binding AddLaunchRuleCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                        <Button Grid.Column="3" Content="恢复默认" Command="{Binding ResetLaunchCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                    </Grid>
                    <TextBlock Text="匹配当前测试目录内的启动文件；找不到会提示手动指定，不影响双击解压。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <ItemsControl ItemsSource="{Binding LaunchRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="启用 / 停用"/>
                                        <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="245"
                                                 Style="{StaticResource ModernTextBoxStyle}" ToolTip="支持 * 和 ? 通配符，如 Start*.cmd"/>
                                        <Button Content="↑" Command="{Binding DataContext.MoveLaunchUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="8,0,0,0" ToolTip="提高优先级"/>
                                        <Button Content="↓" Command="{Binding DataContext.MoveLaunchDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="5,0,0,0" ToolTip="降低优先级"/>
                                        <Button Content="删除" Command="{Binding DataContext.RemoveLaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="5,0,0,0"/>
                                    </WrapPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="② 拖拽文件规则" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ 新增" Command="{Binding AddDragRuleCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                        <Button Grid.Column="3" Content="恢复默认" Command="{Binding ResetDragCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                    </Grid>
                    <TextBlock Text="完全按以下规则匹配；默认只选 Result ZIP。找不到就提示，绝不会自动改选日志；确实需要 .log 时可自行新增。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <ItemsControl ItemsSource="{Binding DragRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="245"
                                                 Style="{StaticResource ModernTextBoxStyle}" ToolTip="如 *_Result.zip 或 *.log"/>
                                        <Button Content="↑" Command="{Binding DataContext.MoveDragUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="8,0,0,0"/>
                                        <Button Content="↓" Command="{Binding DataContext.MoveDragDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="5,0,0,0"/>
                                        <Button Content="删除" Command="{Binding DataContext.RemoveDragCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="12,5" Margin="5,0,0,0"/>
                                    </WrapPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="③ 自动分类规则" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ 新增分类" Command="{Binding AddClassificationRuleCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                        <Button Grid.Column="3" Content="恢复原分类" Command="{Binding ResetClassificationCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4"/>
                    </Grid>
                    <TextBlock Text="已转换原有分类条件。可使用现有分类，或填入新分类名称及根目录内的新目录；未匹配文件留在收件箱。Result 归档与 Stable 冻结保护仍由系统独立处理。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <ItemsControl ItemsSource="{Binding ClassificationRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <controls:CompactPickerControl ItemsSource="{Binding DataContext.ClassificationMatchFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           SelectedValue="{Binding MatchBy, Mode=TwoWay}" Width="95" Height="32"/>
                                            <TextBox Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="235"
                                                     Style="{StaticResource ModernTextBoxStyle}" Margin="6,0,0,0" ToolTip="文件名或 Manifest 字段通配匹配"/>
                                            <Button Content="↑" Command="{Binding DataContext.MoveClassificationUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="10,5" Margin="6,0,0,0"/>
                                            <Button Content="↓" Command="{Binding DataContext.MoveClassificationDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="10,5" Margin="5,0,0,0"/>
                                            <Button Content="删除" Command="{Binding DataContext.RemoveClassificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource RoundedButtonStyle}" Padding="10,5" Margin="5,0,0,0"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="分类" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="126"
                                                     Style="{StaticResource ModernTextBoxStyle}" ToolTip="Manager、IndexLibrary、Feature、Experiment 或自建名称"/>
                                            <TextBlock Text="目录" VerticalAlignment="Center" Margin="12,0,5,0"/>
                                            <TextBox Text="{Binding Directory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                                     Style="{StaticResource ModernTextBoxStyle}" ToolTip="根目录内相对路径；支持 {Feature}、{Stage}、{Version}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                    <TextBlock Text="规则匹配预览" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <TextBox Text="{Binding RulePreviewName, UpdateSourceTrigger=PropertyChanged}" Width="325" Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="要测试的文件名"/>
                        <TextBox Text="{Binding RulePreviewBuildType, UpdateSourceTrigger=PropertyChanged}" Width="95" Margin="6,0,0,0" Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="可选：构建类型（如 Test）"/>
                        <TextBox Text="{Binding RulePreviewBranch, UpdateSourceTrigger=PropertyChanged}" Width="155" Margin="6,0,0,0" Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="可选：分支（如 feature/demo）"/>
                        <Button Content="预览匹配" Command="{Binding PreviewRulesCommand}" Style="{StaticResource RoundedButtonStyle}" Padding="12,4" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding RulePreviewText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,12"/>
                    <Button Content="保存自定义规则与设置" Command="{Binding SaveCommand}" Style="{StaticResource RoundedButtonStyle}"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Padding="18,7"/>
                </StackPanel>
            </Border>

            <!-- Software update -->
            <Border Grid.Row="8" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="300"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="软件更新" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ManagerCurrentVersionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ManagerLatestVersionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ManagerUpdateLastCheckedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ManagerUpdateStatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource RoundedButtonStyle}" Command="{Binding CheckManagerUpdateCommand}" Content="检查更新" Height="32" Padding="12,0"/>
                        <Button Style="{StaticResource RoundedButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding InstallManagerUpdateCommand}" Content="立即更新" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
