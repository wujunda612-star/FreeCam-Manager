<UserControl x:Class="FreeCamManager.Views.CustomCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeCamManager.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="自定义分类" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="单独查看自行创建的分类；修改分类规则不迁移已有文件。" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}" ToolTip="搜索当前分类中的文件名和备注" VerticalAlignment="Bottom"/>
            <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}"
                    Style="{StaticResource RoundedButtonStyle}" Padding="15,5" VerticalAlignment="Bottom"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="分类" Margin="8,5,0,10" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="8,6" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="98"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="分类" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="测试状态（可拖拽）" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="时间" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <ListView x:Name="VersionList" Grid.Row="1" ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}" Background="Transparent"
                              BorderThickness="0" PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                              MouseDoubleClick="VersionList_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="98"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileNameToolTip}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <controls:StatusBadge Grid.Column="2" Text="{Binding TestStatus}" ToolTip="{Binding ResultHint}"
                                        PreviewMouseLeftButtonDown="ResultBadge_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ResultBadge_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="ResultBadge_PreviewMouseLeftButtonUp"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TimeDisplay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="开始测试（双击，限测试 ZIP）" Command="{Binding SelectedRow.StartTestCommand}"/>
                                <MenuItem Header="打开测试目录" Command="{Binding SelectedRow.OpenTestingFolderCommand}"/>
                                <Separator/>
                                <MenuItem Header="指定本版本启动文件" Command="{Binding SelectedRow.SelectLaunchFileCommand}"/>
                                <MenuItem Header="清除启动文件指定" Command="{Binding SelectedRow.ClearLaunchFileCommand}"/>
                                <MenuItem Header="指定本版本拖拽文件" Command="{Binding SelectedRow.SelectDragFileCommand}"/>
                                <MenuItem Header="清除拖拽文件指定" Command="{Binding SelectedRow.ClearDragFileCommand}"/>
                                <MenuItem Header="定位当前拖拽文件" Command="{Binding SelectedRow.OpenResultCommand}"/>
                                <Separator/>
                                <MenuItem Header="重新解压" Command="{Binding SelectedRow.ReextractCommand}"/>
                                <MenuItem Header="定位原始文件" Command="{Binding SelectedRow.OpenLocationCommand}"/>
                                <MenuItem Header="编辑备注" Command="{Binding SelectedRow.EditNotesCommand}"/>
                                <MenuItem Header="{Binding SelectedRow.ProtectionMenuText}" Command="{Binding SelectedRow.ToggleProtectionCommand}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
