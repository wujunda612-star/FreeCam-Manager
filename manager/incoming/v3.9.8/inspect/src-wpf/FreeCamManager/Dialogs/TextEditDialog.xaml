<Window x:Class="FreeCamManager.Dialogs.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑" Width="470" SizeToContent="Height" MinHeight="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Margin="1" Background="{DynamicResource PanelBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="10,10,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"/><Button Grid.Column="1" Style="{StaticResource WindowButtonStyle}" Width="32" Height="30" Click="Close_Click"><Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Width="12" Height="12"/></Button></Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="LabelText" Grid.Row="0" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="Editor" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" MinHeight="38" MaxHeight="240" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Style="{StaticResource RoundedButtonStyle}" Width="82" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="确定" Style="{StaticResource RoundedButtonStyle}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Width="82" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
