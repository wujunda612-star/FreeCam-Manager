<UserControl x:Class="FreeCamManager.Controls.StarRatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28" Width="18" MinWidth="18" Focusable="False">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border x:Name="Segment5" Tag="5" Width="13" Height="3" Margin="0,0,0,2" CornerRadius="1.5" Cursor="Hand" MouseLeftButtonUp="Segment_Click"/>
        <Border x:Name="Segment4" Tag="4" Width="13" Height="3" Margin="0,0,0,2" CornerRadius="1.5" Cursor="Hand" MouseLeftButtonUp="Segment_Click"/>
        <Border x:Name="Segment3" Tag="3" Width="13" Height="3" Margin="0,0,0,2" CornerRadius="1.5" Cursor="Hand" MouseLeftButtonUp="Segment_Click"/>
        <Border x:Name="Segment2" Tag="2" Width="13" Height="3" Margin="0,0,0,2" CornerRadius="1.5" Cursor="Hand" MouseLeftButtonUp="Segment_Click"/>
        <Border x:Name="Segment1" Tag="1" Width="13" Height="3" CornerRadius="1.5" Cursor="Hand" MouseLeftButtonUp="Segment_Click"/>
    </StackPanel>
</UserControl>
