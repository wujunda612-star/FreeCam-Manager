<UserControl x:Class="FreeCamManager.Controls.LockToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="30" Height="28" Focusable="False">
    <Button Click="Button_Click" Style="{StaticResource WindowButtonStyle}" Width="28" Height="26" Padding="0" ToolTip="点击锁定 / 解锁">
        <Path x:Name="LockPath" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource LockBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Button>
</UserControl>
