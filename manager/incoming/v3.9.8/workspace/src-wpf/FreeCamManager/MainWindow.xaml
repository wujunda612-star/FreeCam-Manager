<Window x:Class="FreeCamManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FreeCamManager.ViewModels"
        xmlns:views="clr-namespace:FreeCamManager.Views"
        Title="{Binding WindowTitle}" Icon="Assets/FreeCamManager.ico"
        Width="1180" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevelopmentViewModel}"><views:DevelopmentView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StableViewModel}"><views:StableView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" CornerRadius="10,10,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFreeCam}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="19" Height="19" Stretch="Uniform"/>
                        <TextBlock Text="FreeCam 可视化管理器" FontWeight="SemiBold" FontSize="13.5" Margin="9,0,0,0"/>
                        <TextBlock Text="{Binding AppDisplayVersion}" Style="{StaticResource MutedTextStyle}" Margin="8,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="最小化"><Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="最大化 / 还原"><Path Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" ToolTip="关闭"><Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,14,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <RadioButton GroupName="Nav" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="首页">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconHome}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.45" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="首页" Margin="11,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="开发中">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDevelopment}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="开发中" Margin="11,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="稳定版">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconStable}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="稳定版" Margin="11,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="历史">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconHistory}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.45" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="历史" Margin="11,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <RadioButton Grid.Row="2" GroupName="Nav" Style="{StaticResource NavRadioButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="设置">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.25" Width="17" Height="17" Stretch="Uniform"/><TextBlock Text="设置" Margin="11,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Margin="20,18,20,12"/>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                <Grid Margin="14,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
